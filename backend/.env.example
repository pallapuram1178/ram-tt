PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/servicedesk_pro
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI Helpdesk Chatbot Settings
# Supported AI_PROVIDER: 'gemini', 'openai', or 'mock' (default fallback with internal RAG)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
